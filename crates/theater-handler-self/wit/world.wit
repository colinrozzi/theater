/// WIT world for the Runtime Handler
///
/// This world defines what the host provides to actors that import
/// the theater:simple/self interface for core runtime capabilities.

package theater:self-handler;

world self-handler-host {
    /// Theater simple runtime interface
    /// Provides logging and shutdown capabilities
    import theater:simple/self;

    /// Types used by the runtime interface
    import theater:simple/types;
}
